rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /sites/{siteId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.resource.data.name is string && request.resource.data.name.size() <= 128;
      allow delete: if isSignedIn();
    }

    match /dossiers/{dossierId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.resource.data.campaignTitle is string && request.resource.data.campaignTitle.size() <= 200;
      allow delete: if isSignedIn();
    }
  }
}
